rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(clinicId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }
    function validUpload() {
      return request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('(audio/.*|image/.*|application/pdf)');
    }

    match /clinics/{clinicId}/patients/{patientId}/{allPaths=**} {
      allow get, list: if isMember(clinicId);
      allow create, update: if isMember(clinicId) && validUpload();
      allow delete: if isMember(clinicId);
    }
  }
}
